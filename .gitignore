# 클래스룸 자동 게시 — 웹앱 URL·토큰이 들어간다 (예시는 .classroom.example.json). gitignore에서 제외. 현재 공개된 github repository가 아니기 때문.
#.classroom.json
#docs/apps-script/classroom/.clasp.json

# 스킬 스크립트 작업 폴더 (이미지 생성 스테이징·시트 원본·검수 스크린샷)
tmp/

# ── 에이전트 작업 부산물 (2026-08-21 정리) ──
.omg/
.playwright-cli/
*.stackdump

# 스모크 테스트가 실행할 때마다 덮어쓰는 검수 스크린샷 — 테스트 코드(.mjs/.html)는 계속 추적한다
test/*.png
test/*.jpg

# 백업본 — 원본이 이 저장소에 그대로 있다
/.claude/*.zip
/.claude/commands/*.zip
/.claude/backup/
/backup/
**/_notebooklm_output/backup_v1/

# 외부 디자인 라이브러리 — 이 프로젝트 코드가 참조하지 않는다
/open-design/

# 외부에서 추출한 참고 자료 — 코드·스킬이 참조하지 않는다
/knowledge/

# 발표자 나레이션 영상 완성본 (deck-narration-builder) — 캐스트마다 수백 MB. dev 서버가 /presenter-media/로 서빙, 배포에는 안 들어간다
/presenter-media/

# 공개판 — 비밀값이 든 설정
.classroom.json
.clasp.json
.clasp-deployment
